# TellMe: безопасный шаблон локального окружения.
# Значения ниже предназначены только для разработки и не должны использоваться в production.

# HTTP
TELLME_RUST_BIND_ADDR=0.0.0.0:3100
TELLME_RUST_SHUTDOWN_TIMEOUT_MS=5000
SERVER_DOMAIN=localhost
SERVER_DOMAIN_ALIASES=
MAX_FILE_SIZE=10485760

# PostgreSQL
DATABASE_URL=postgresql://tellme:tellme-dev-password@postgres:5432/tellme
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECT_RETRY_ATTEMPTS=20
DATABASE_CONNECT_RETRY_DELAY_MS=500

# Redis
REDIS_URL=redis://redis:6379

# Подпись session/refresh tokens. Замените перед любым сетевым развёртыванием.
JWT_SECRET=local-session-secret-change-before-deploy
JWT_REFRESH_SECRET=local-refresh-secret-change-before-deploy
SESSION_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# S3-совместимое хранилище зашифрованных вложений
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=tellme-local
MINIO_SECRET_KEY=tellme-local-password
MEDIA_BUCKET=tellme-ciphertext

# Фоновые workers отключены в минимальном локальном контуре.
TELLME_RUST_WORKERS_ENABLED=false
TELLME_RUST_WORKER_RESERVE_LIMIT=50
TELLME_RUST_WORKER_CLAIM_TTL_SEC=300

# TURN. Эти значения демонстрационные; реальный relay требует отдельного coturn.
TURN_STATIC_SECRET=local-turn-secret-change-before-deploy
TURN_CREDENTIAL_TTL_SEC=300
TURN_SERVER_URL_UDP=turn:localhost:3478?transport=udp
TURN_SERVER_URL_TCP=turn:localhost:3478?transport=tcp

# Federation signing используется только при включённой межсерверной доставке.
SERVER_SIGN_KEY_ID=ed25519:local
SERVER_SIGN_PRIVATE_KEY=
FEDERATION_REQUEST_TIMEOUT_MS=5000

# APNs отключён: приватный .p8-файл никогда не хранится в репозитории.
APNS_ENABLED=false
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=
APNS_PRIVATE_KEY_BASE64=
