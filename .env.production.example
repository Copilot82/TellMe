# TellMe: шаблон production-конфигурации.
# Скопируйте файл в .env.production и замените все значения CHANGE_ME.
# Файл .env.production содержит секреты и не должен попадать в Git.

# Публичные адреса
SERVER_DOMAIN=chat.example.com
SERVER_DOMAIN_ALIASES=
TURN_EXTERNAL_IP=203.0.113.10
TURN_PRIVATE_IP=203.0.113.10

# Порты хоста. Значения по умолчанию нужны для автоматического TLS и WebRTC.
HTTP_PORT=80
HTTPS_PORT=443
TURN_LISTENING_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535

# PostgreSQL. Генератор создаёт URL-safe значения; при ручной замене используйте hex.
POSTGRES_DB=tellme
POSTGRES_USER=tellme
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECT_RETRY_ATTEMPTS=30
DATABASE_CONNECT_RETRY_DELAY_MS=1000

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS

# Session и refresh tokens
JWT_SECRET=CHANGE_ME_JWT
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH
SESSION_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# S3-совместимое хранилище зашифрованных вложений
MINIO_ACCESS_KEY=tellme
MINIO_SECRET_KEY=CHANGE_ME_MINIO
MINIO_REGION=us-east-1
MEDIA_BUCKET=tellme-ciphertext
MAX_FILE_SIZE=10485760

# Подпись межсерверного обмена. Значение — base64 от 32-байтового Ed25519 seed.
SERVER_SIGN_KEY_ID=ed25519:1
SERVER_SIGN_PRIVATE_KEY=CHANGE_ME_ED25519_SEED

# STUN/TURN
TURN_STATIC_SECRET=CHANGE_ME_TURN
TURN_CREDENTIAL_TTL_SEC=300
STUN_SERVER=stun:chat.example.com:3478
TURN_SERVER_URL_UDP=turn:chat.example.com:3478?transport=udp
TURN_SERVER_URL_TCP=turn:chat.example.com:3478?transport=tcp
TURN_SERVER_FALLBACK_URL_UDP=
TURN_SERVER_FALLBACK_URL_TCP=

# APNs. Для первого server-only smoke можно оставить false. Для приложения на устройствах
# включите APNs и заполните Bundle ID, Key ID и Team ID из Apple Developer.
APNS_ENABLED=false
APNS_BUNDLE_ID=com.example.tellme
APNS_VOIP_TOPIC=com.example.tellme.voip
APNS_PRODUCTION=true
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=/run/secrets/tellme/AuthKey.p8
APNS_PRIVATE_KEY_BASE64=
APNS_REQUEST_TIMEOUT_MS=10000

# Runtime
TELLME_RUST_BIND_ADDR=0.0.0.0:3100
TELLME_RUST_SHUTDOWN_TIMEOUT_MS=5000
TELLME_RUST_WORKERS_ENABLED=true
TELLME_RUST_WORKER_RESERVE_LIMIT=50
TELLME_RUST_WORKER_CLAIM_TTL_SEC=300
USE_REDIS_ADAPTER=true
CORS_ORIGINS=

# Rate limits и worker intervals. Обычно эти значения не меняют при первом запуске.
AUTH_RATE_LIMIT_PER_MINUTE=20
PUBLIC_DIRECTORY_RATE_LIMIT_PER_MINUTE=60
FEDERATION_PREAUTH_RATE_LIMIT_PER_MINUTE=60
FEDERATION_RATE_LIMIT_PER_MINUTE=600
FEDERATION_REQUEST_TIMEOUT_MS=5000
TURN_CREDENTIALS_RATE_LIMIT_PER_MINUTE=30
MEDIA_UPLOAD_INIT_RATE_LIMIT_PER_MINUTE=30
MEDIA_UPLOAD_RATE_LIMIT_PER_MINUTE=30
MEDIA_DOWNLOAD_RATE_LIMIT_PER_MINUTE=120
MAILBOX_DEFAULT_TTL_SEC=604800
OUTBOX_WORKER_INTERVAL_MS=5000
OUTBOX_JOB_CLAIM_TTL_SEC=60
PUSH_WORKER_INTERVAL_MS=2000
PUSH_DEDUPE_WINDOW_SEC=30
PUSH_JOB_CLAIM_TTL_SEC=60
MEDIA_CLEANUP_INTERVAL_MS=60000
MAILBOX_CLEANUP_INTERVAL_MS=60000
WS_SESSION_STALE_MS=12000
WS_OFFLINE_OVERRIDE_TTL_SEC=20
